def water_jug_dfs(capacity1, capacity2, target):
    visited = set()
    path = []

    def dfs(x, y):
        if (x, y) in visited:
            return False

        visited.add((x, y))
        path.append((x, y))

        if x == target or y == target:
            return True

        states = [
            (capacity1, y),   # Fill Jug 1
            (x, capacity2),   # Fill Jug 2
            (0, y),            # Empty Jug 1
            (x, 0)             # Empty Jug 2
        ]

        # Pour Jug 1 into Jug 2
        n = min(x, capacity2 - y)
        states.append((x - n, y + n))

        # Pour Jug 2 into Jug 1
        n = min(y, capacity1 - x)
        states.append((x + n, y - n))

        for a, b in states:
            if dfs(a, b):
                return True

        path.pop()
        return False

    
if dfs(0, 0):
        print("Solution Path:")
        for state in path:
            print(state)
    else:
        print("No solution exists.")


# User input
capacity1 = int(input("Enter Jug 1 capacity: "))
capacity2 = int(input("Enter Jug 2 capacity: "))
target = int(input("Enter target amount: "))

water_jug_dfs(capacity1, capacity2, target)
