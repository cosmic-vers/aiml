from collections import deque

# Check whether a state is valid
def valid(m, c, total_m, total_c):
    # Left bank
    if m < 0 or c < 0 or m > total_m or c > total_c:
        return False

    # Right bank
    mr = total_m - m
    cr = total_c - c

    # Missionaries should not be outnumbered
    if m > 0 and c > m:
        return False

    if mr > 0 and cr > mr:
        return False

    return True


def bfs(total_m, total_c):
    # State = (missionaries_left, cannibals_left, boat_position)
    # 0 = left, 1 = right
    start = (total_m, total_c, 0)
    goal = (0, 0, 1)

    # Possible boat movements
    moves = [(1, 0), (2, 0), (0, 1), (0, 2), (1, 1)]

    queue = deque([(start, [start])])
    visited = {start}

    while queue:
        state, path = queue.popleft()
        m, c, boat = state

        if state == goal:
            return path

        for dm, dc in moves:

            if boat == 0:       # Boat moves Left -> Right
                new_state = (m - dm, c - dc, 1)
            else:               # Boat moves Right -> Left
                new_state = (m + dm, c + dc, 0)

            if valid(new_state[0], new_state[1], total_m, total_c):
                if new_state not in visited:
                    visited.add(new_state)
                    queue.append((new_state, path + [new_state]))

    return None


# User input
M = int(input("Enter number of missionaries: "))
C = int(input("Enter number of cannibals: "))

solution = bfs(M, C)

if solution:
    print("\nBFS Solution:")
    for state in solution:
        print(state)
else:
    print("No solution exists.")
